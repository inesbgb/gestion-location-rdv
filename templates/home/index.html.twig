{% extends 'base.html.twig' %}

{% block title %}
  Accueil
{% endblock %}

{% block body %}
    <div class="hero-section">
        {% set video = attribute(elementAdmin, 'videoFilename') %}
        {% if video is not empty %}
        <video id="background-video"
            data-src="{{ asset('uploads/videos/' ~ video) }}"
            autoplay
            muted
            loop>
            <source data-src="{{ asset('uploads/videos/' ~ video) }}"
            type="video/mp4" />Votre navigateur ne supporte pas la vidéo HTML5.
        </video>
        {% endif %}
        <div id="hero-content"
            class="absolute top-0 w-full text-center bg-white text-black py-2 overflow-hidden gradient-background">
            <div class="marquee-wrapper">
                <div class="marquee">
                    <span class="accroche inline-block text-lg">
                        Louez ou achetez la robe parfaite - Découvrez notre collection
                        exclusive de robes pour invités et mariées. Vous rêvez de votre robe
                        de mariée sur mesure ? Avec nous, c'est possible ! Prenez
                        rendez-vous dès maintenant en cliquant sur le bouton ci-dessous.
                    </span>
                    <span class="accroche inline-block text-lg">
                        Louez ou achetez la robe parfaite - Découvrez notre collection
                        exclusive de robes pour invités et mariées. Vous rêvez de votre robe
                        de mariée sur mesure ? Avec nous, c'est possible ! Prenez
                        rendez-vous dès maintenant en cliquant sur le bouton ci-dessous.
                    </span>
                </div>
            </div>
        </div>
        <a href="{{ path('app_appointment') }}" class="button">
        Prendre Rendez-vous
        </a>
  </div>
  <!-- Section Nouvelle Collection -->
  <div class="pt-16">
    <div class="container px-3 mx-auto">
      <h2 class="text-4xl font-bold text-center text-black mb-12">
        Nouvelle Collection de Robes à Louer
      </h2>
      <div class="relative mx-auto w-full">
        <!-- Le carrousel -->
        <div class="swiper mySwiper">
          <div class="swiper-wrapper">
            {% for i in 1..6 %}
              <div class="swiper-slide flex justify-center items-center">
                {% set produit = attribute(elementAdmin, 'carouselImage' ~ i) %}
                {% if produit and produit.getImageName is not empty %}
                  <a href="{{
                    path(
                      'app_produit_show',
                      {
                        id: produit.id
                      }
                    )
                    }}"
                    class="flex justify-center items-center">
                    <div class="carousel-image-container">
                      <img src="{{
                        asset(
                          'images/produit/' ~ produit.getImageName
                        )
                        }}"
                        alt="Carousel Image {{ i }}"
                        class="carousel-image" />
                    </div>
                  </a>
                {% else %}
                  <div class="carousel-placeholder">
                    <span class="text-gray-500 text-lg">Image {{ i }}</span>
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Section Location à Distance -->
  <div class="pt-16 bg-white border-t-2 border-b-2 border-[#b98f42]">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl font-bold text-black mb-6">
          Location à Distance
        </h2>
        <p class="text-xl text-black mb-8">
          Nous proposons nos services de location dans toute la France ! Peu
          importe où vous vous trouvez, faites-vous livrer votre tenue de rêve
          directement chez vous.
        </p>
        <div class="flex flex-col md:flex-row gap-4 justify-center items-center">
          <a href="mailto:contact@cnkcouture.fr?subject=Location à distance&body=Bonjour,%0D%0A%0D%0AJe souhaite faire une location à distance.%0D%0AContactez-moi au numéro suivant : %0D%0A%0D%0ANom : %0D%0APrénom : %0D%0ATéléphone : "
    class="bg-gold-gradient text-white font-bold px-6 py-3 rounded-lg hover:bg-white hover:text-[#b98f42] hover:border-2 hover:border-[#b98f42] transform transition-all duration-300 shadow-md hover:shadow-lg">
    Envoyer un mail 
</a>
          <button type="button"
            id="openModalBtn"
            class="!block !relative border-2 !border-gold-light !text-gold-light !px-6 !py-3 !rounded-lg !cursor-pointer hover:!bg-gold-light hover:!text-white !z-10">
            Conditions de location
          </button>
        </div>
        <!-- Espace supplémentaire -->
        <div class="h-20"></div>
      </div>
    </div>
  </div>

  <!-- Modal -->

  
  <!-- Section Avis Clients -->
  <div class="py-10 custom-margin-top">
    <h2 class="text-center text-3xl font-bold text-black mb-8">
      Avis Clients
    </h2>
    <div class="container px-3 mx-auto">
      <div class="relative mx-auto w-full">
        <div class="swiper mySwiper">
          <div class="swiper-wrapper">
            {% for avisClient in avisClients %}
              <div class="swiper-slide">
                <div class="client-review-slide">
                  <div class="flex flex-col items-center justify-center h-full text-center p-6">
                    <div class="text-gold mb-2">
                      ★★★★★
                    </div>
                    <h3 class="font-bold text-lg mb-4">
                      {{ avisClient.prenom }}
                    </h3>
                    <p class="text-gray-700">
                      {{ avisClient.commentaire }}
                    </p>
                  </div>
                </div>
              </div>
            {% else %}
              <div class="swiper-slide">
                <div class="client-review-slide">
                  <div class="flex items-center justify-center h-full text-center p-6">
                    <p class="text-gold-700">
                      Aucun avis client disponible pour le moment.
                    </p>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
  {# La modal à la racine du template (juste avant la fin du body) #}
  <div id="conditionsModal"
    class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden">
    <div class="fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-white rounded-lg p-8 max-w-md w-full mx-4"
      onclick="event.stopPropagation()">
      <button type="button"
        id="closeModalBtn"
        class="absolute top-4 right-4 text-gray-500 hover:text-gray-700 text-2xl font-bold">
        ×
      </button>
      <h3 class="text-2xl font-bold text-black mb-4">
        Conditions pour une location à distance
      </h3>
      <div class="text-gray-700 space-y-4">
        <p>
          Pour réserver une robe un acompte de 50% vous sera demandé via PayPal
          ou virement bancaire
        </p>
        <p>
          Les frais de livraisons seront à votre charge 20€
        </p>
        <p>
          Une caution sera demandée par chèque ou virement avant l'envoi de la
          robe. Elle vous sera retournée après réception de la robe. Une copie
          de la carte d'identité est également requise.
        </p>
        <p>
          Vous devez déposer la robe à la poste le lundi avant 16h. Sinon des
          frais de retard seront facturés 😊
        </p>
      </div>
    </div>
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    document.addEventListener('DOMContentLoaded', function() { const video =
    document.getElementById('background-video'); const content =
    document.getElementById('hero-content');

    if (video) { // Utilisation de l'Intersection Observer pour le lazy loading
    const observer = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => { if (entry.isIntersecting) { video.src =
    video.dataset.src; video.load(); observer.unobserve(video); } }); });

    observer.observe(video);

    video.addEventListener('loadeddata', function() { const canvas =
    document.createElement('canvas'); const context = canvas.getContext('2d');
    canvas.width = video.videoWidth; canvas.height = video.videoHeight;

    context.drawImage(video, 0, 0, canvas.width, canvas.height); const frame =
    context.getImageData(0, 0, canvas.width, canvas.height); const length =
    frame.data.length; let totalBrightness = 0;

    for (let i = 0; i < length; i += 4) { const r = frame.data[i]; const g =
    frame.data[i + 1]; const b = frame.data[i + 2]; const brightness = (r + g +
    b) / 3; totalBrightness += brightness; }

    const averageBrightness = totalBrightness / (length / 4);
    content.style.color = averageBrightness < 128 ? 'white' : 'black'; }); } });
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function() { const
    swiperOptions = { slidesPerView: 1, spaceBetween: 30, breakpoints: { 640: {
    slidesPerView: 1, spaceBetween: 20, }, 768: { slidesPerView: 2,
    spaceBetween: 30, }, 1024: { slidesPerView: 3, spaceBetween: 40, }, }, };

    document.querySelectorAll('.mySwiper').forEach(function(element) { new
    Swiper(element, swiperOptions); }); });
  </script>
  <!-- Script de la modal -->
  <script>
        console.log('Chargement du script modal');
        
        // On attend que le DOM soit complètement chargé
        window.addEventListener('load', function() {
            console.log('Page entièrement chargée');
            
            // Récupération des éléments
            const openBtn = document.getElementById('openModalBtn');
            const closeBtn = document.getElementById('closeModalBtn');
            const modal = document.getElementById('conditionsModal');
            
            console.log('Éléments trouvés:', {
                bouton: openBtn,
                modal: modal,
                boutonFermeture: closeBtn
            });
            
            // Gestionnaire pour ouvrir la modal
            if (openBtn) {
                openBtn.addEventListener('click', function() {
                    console.log('Clic sur le bouton');
                    if (modal) {
                        modal.classList.remove('hidden');
                        console.log('Modal ouverte');
                    }
                });
            }
            
            // Gestionnaire pour fermer la modal
            if (closeBtn) {
                closeBtn.addEventListener('click', function() {
                    if (modal) {
                        modal.classList.add('hidden');
                    }
                });
            }
            
            // Fermer en cliquant en dehors
            if (modal) {
                modal.addEventListener('click', function(e) {
                    if (e.target === modal) {
                        modal.classList.add('hidden');
                    }
                });
            }
        });
    </script>
{% endblock %}
