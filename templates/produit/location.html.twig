{% extends 'base.html.twig' %}

{% block title %}Nos Robes{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 pt-24 sm:pt-24 mt-10 mb-12">
        <h1 class="text-3xl font-bold mb-8 text-center mt-5" >Nos Robes en location</h1>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {% for produit in produits %}
                <a href="{{ path('app_produit_show', {'id': produit.id}) }}" class="block bg-white shadow-md rounded-lg overflow-hidden hover:shadow-lg transition-shadow duration-300">
                    {% if produit.imageUrl %}
                        <div class="w-full h-96 flex items-center justify-center bg-gray-200">
                            <img src="{{ produit.imageUrl }}" alt="{{ produit.designation }}" class="w-full h-full object-cover object-center">
                        </div>
                    {% else %}
                        <div class="w-full h-96 flex items-center justify-center bg-gray-200">
                            No image
                        </div>
                    {% endif %}
                    <div class="p-4 text-center">
                        <h2 class="text-lg font-semibold">{{ produit.designation }}</h2>
                        
                        <p class="text-gray-900 font-bold">{{ produit.prix }} €</p>
                    </div>
                </a>
            {% else %}
                <div class="col-span-1 sm:col-span-2 md:col-span-3 lg:col-span-4">
                    <p class="text-center text-gray-500">Aucun produit trouvé</p>
                </div>
            {% endfor %}
        </div>

        {# Pagination #}
        {% if produits.haveToPaginate is defined and produits.haveToPaginate %}
            <div class="mt-8 flex justify-center">
                <nav class="inline-flex rounded-md shadow">
                    {% if produits.hasPreviousPage %}
                        <a href="{{ path('app_produit_location', {'page': produits.currentPage - 1}) }}" class="px-3 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                            Précédent
                        </a>
                    {% endif %}
                    <span class="px-3 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700">
                        Page {{ produits.currentPage }} sur {{ produits.lastPage }}
                    </span>
                    {% if produits.hasNextPage %}
                        <a href="{{ path('app_produit_location', {'page': produits.currentPage + 1}) }}" class="px-3 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                            Suivant
                        </a>
                    {% endif %}
                </nav>
            </div>
        {% endif %}
    </div>
{% endblock %}