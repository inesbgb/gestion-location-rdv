{% extends 'base.html.twig' %}

{% block title %}ElementAdmin{% endblock %}

{% block body %}
    <h1>ElementAdmin</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ element_admin.id }}</td>
            </tr>
            <tr>
                <th>Vidéo</th>
                <td>
                    {% if element_admin.videoFilename %}
                        <video width="320" height="240" controls>
                            <source src="{{ asset('uploads/videos/' ~ element_admin.videoFilename) }}" type="video/mp4">
                            Votre navigateur ne supporte pas la vidéo.
                        </video>
                    {% else %}
                        <span class="text-gray-500">Aucune vidéo</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>CarouselImage1</th>
                <td>{{ element_admin.carouselImage1 }}</td>
            </tr>
            <tr>
                <th>CarouselImage2</th>
                <td>{{ element_admin.carouselImage2 }}</td>
            </tr>
            <tr>
                <th>CarouselImage3</th>
                <td>{{ element_admin.carouselImage3 }}</td>
            </tr>
            <tr>
                <th>CarouselImage4</th>
                <td>{{ element_admin.carouselImage4 }}</td>
            </tr>
            <tr>
                <th>CarouselImage5</th>
                <td>{{ element_admin.carouselImage5 }}</td>
            </tr>
            <tr>
                <th>CarouselImage6</th>
                <td>{{ element_admin.carouselImage6 }}</td>
            </tr>
            <tr>
                <th>ImageHistoire</th>
                <td>{{ element_admin.imageHistoire }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_element_admin_index') }}">back to list</a>

    <a href="{{ path('app_element_admin_edit', {'id': element_admin.id}) }}">edit</a>

    {{ include('element_admin/_delete_form.html.twig') }}
{% endblock %}
